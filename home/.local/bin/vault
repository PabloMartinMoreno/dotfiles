#!/bin/sh
# Abre el vault en nvim.
# Desde una terminal: en la misma ventana. Desde dmenu o un atajo del WM: en una
# ventana de kitty.
# La ruta sale de OBSIDIAN_VAULT; exportala en tu perfil de shell.
DIR="${OBSIDIAN_VAULT:-$HOME/vault}"

[ -d "$DIR" ] || {
	printf 'no existe el vault: %s\nexportá OBSIDIAN_VAULT con la ruta correcta\n' "$DIR" >&2
	exit 1
}

cd "$DIR" || exit 1

# No alcanza con [ -t 1 ]: si X arrancó con startx, el WM hereda /dev/tty1 y
# todo lo que se lance desde dmenu lo hereda también. nvim se abriría en la
# consola de texto, tapada por X y sin teclado — parece que se colgó la máquina.
# Un emulador de terminal siempre da un pseudo-terminal (/dev/pts/*).
# fd 3 conserva el stdout real: dentro de $( ) el fd 1 es el pipe de la
# substitución, no la terminal.
exec 3>&1
case "$(readlink /proc/self/fd/3 2>/dev/null)" in
/dev/pts/*)
	exec nvim Inicio.md
	;;
*)
	exec kitty --directory "$DIR" --title "$(basename "$DIR")" -e nvim Inicio.md
	;;
esac
